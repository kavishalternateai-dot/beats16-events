# Public analytics. Leave blank to disable the GA4 snippet.
# Only a GA4 measurement ID (G-XXXXXXXX) is accepted.
NEXT_PUBLIC_GA_ID=

# Optional email delivery for inquiry and showreel leads.
# Leave all three blank to log leads on the server instead of emailing them.
# INQUIRY_FROM_EMAIL must be a sender Resend has verified. beats16.events
# is not attached yet, so this stays empty until a domain is verified.
RESEND_API_KEY=
INQUIRY_FROM_EMAIL=
INQUIRY_TO_EMAIL=beats16@gmail.com

# Reel permalinks. Full https://www.instagram.com/reel/SHORTCODE/ URLs.
# Empty values keep the labeled placeholder on the band page.
# Changing these requires a redeploy. You can also paste permalinks into content/media.ts.
REEL_GAURI_1=
REEL_GAURI_2=
REEL_RDX_1=
REEL_RDX_2=
REEL_DAASTAN_1=
REEL_DAASTAN_2=
REEL_NAVRATRI_1=
REEL_NAVRATRI_2=
REEL_INDEPENDENT_1=
REEL_INDEPENDENT_2=

# Optional https links (for example Google Drive) for real showreels.
# Empty values serve the placeholder PDF in public/showreels after the form is sent.
SHOWREEL_GAURI_URL=
SHOWREEL_RDX_URL=
SHOWREEL_DAASTAN_URL=
SHOWREEL_NAVRATRI_URL=
SHOWREEL_INDEPENDENT_URL=
