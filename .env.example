# Canonical site origin for metadata, sitemap, robots and schema.
# Leave unset to use https://beats16-events.vercel.app until the live domain is ready.
NEXT_PUBLIC_SITE_URL=

# Public analytics. Leave blank to disable the GA4 snippet.
# Only a GA4 measurement ID (G-XXXXXXXX) is accepted.
NEXT_PUBLIC_GA_ID=

# Optional email delivery for inquiry and showreel leads.
# Leave all three blank to skip Resend. The server log still records the lead.
# INQUIRY_FROM_EMAIL must be a sender Resend has verified.
RESEND_API_KEY=
INQUIRY_FROM_EMAIL=
INQUIRY_TO_EMAIL=beats16@gmail.com

# Optional second sink. POST each lead as JSON to a Google Apps Script web app
# (or any receiver). See README and scripts/apps-script-leads.gs.
# Apps Script does not read custom headers, so include the secret on the URL:
# https://script.google.com/macros/s/.../exec?secret=THE_SECRET
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=

# Reel permalinks. Full https://www.instagram.com/reel/SHORTCODE/ URLs.
# Empty values keep the Instagram link tile. No reel frame is shown.
# Changing these requires a redeploy. You can also paste permalinks into content/media.ts.
REEL_GAURI_1=
REEL_GAURI_2=
REEL_RDX_1=
REEL_RDX_2=
REEL_DAASTAN_1=
REEL_DAASTAN_2=
REEL_NAVRATRI_1=
REEL_NAVRATRI_2=
REEL_INDEPENDENT_1=
REEL_INDEPENDENT_2=

# Optional https links (for example Google Drive) for real showreels.
# Empty values hide the download form. Set an https file URL to show it.
SHOWREEL_GAURI_URL=
SHOWREEL_RDX_URL=
SHOWREEL_DAASTAN_URL=
SHOWREEL_NAVRATRI_URL=
SHOWREEL_INDEPENDENT_URL=

# Optional photo and film overrides. Each value is a public path such as
# /media/gauri-hero.jpg. The file must already be in public/media/.
# Leave blank to use content/media.ts, or a file dropped in as public/media/<slot-id>.<ext>.
MEDIA_HOME_WEDDING=
MEDIA_HOME_NAVRATRI=
MEDIA_HOME_FILM=
MEDIA_HOME_FILM_POSTER=
MEDIA_ABOUT_CELEBRATION=
MEDIA_ABOUT_BAND=
MEDIA_WEDDINGS_HERO=
MEDIA_GAURI_HERO=
MEDIA_RDX_HERO=
MEDIA_DAASTAN_HERO=
MEDIA_NAVRATRI_HERO=
MEDIA_CORPORATE_HERO=
MEDIA_FAQ_HERO=
MEDIA_CONTACT_HERO=
MEDIA_INDEPENDENT_HERO=
